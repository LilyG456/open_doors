// Open Doors backend data model.
//
// Design principle: nothing that reads as a "rating" or "rank" is stored directly.
// People submit structured, honest, first-person reports about a single visit
// (Experience + its optional yes/no/scale fields). Everything shown on a church's
// page — the Community Snapshot bars, the transparency counts, the map pin color —
// is *computed* from approved Experiences at read time (see lib/aggregation.ts).
// That keeps the aggregate numbers traceable back to real submissions instead of
// being editable facts that could be gamed or feel like a verdict.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js required models (Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- People ----------

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  // Shown publicly on their own experiences instead of their real name/email.
  displayName   String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  identities           UserIdentity[]
  experiences          Experience[]
  savedChurches        SavedChurch[]
  helpfulVotes         HelpfulVote[]
  reports              Report[]
  verifiedChurches     ChurchVerification[]
  reviewedSuggestions  DenominationSuggestion[]
  submittedChurchEdits ChurchEditSuggestion[]   @relation("SubmittedChurchEdits")
  reviewedChurchEdits  ChurchEditSuggestion[]   @relation("ReviewedChurchEdits")
  submittedSources     ChurchSource[]
  dismissedSources     ChurchSource[]           @relation("DismissedChurchSources")
  setFieldSources      ChurchFieldSource[]
  reviewedMerges       ChurchMergeCandidate[]
  requestedDeletions   ChurchDeletionRequest[]  @relation("RequestedChurchDeletions")
  reviewedDeletions    ChurchDeletionRequest[]  @relation("ReviewedChurchDeletions")
  accounts             Account[]
  sessions             Session[]
}

// The "I am..." chips used both for a user's own "People Like Me" profile
// and for the identity tags attached to an individual experience.
model Identity {
  id    String @id @default(cuid())
  label String @unique
  order Int    @default(0)

  users       UserIdentity[]
  experiences ExperienceIdentity[]
}

model UserIdentity {
  userId     String
  identityId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([userId, identityId])
}

// ---------- Churches ----------

model Church {
  id            String   @id @default(cuid())
  slug          String   @unique
  // Every slug this church has ever had, oldest first, recorded whenever an
  // admin renames it (see the church PATCH route). Lets old bookmarks,
  // shared links, and search results redirect to the current page instead
  // of 404ing — see app/church/[slug]/page.tsx.
  previousSlugs String[]
  name          String
  denomination  String
  address       String
  city          String
  state         String?
  zip           String?
  lat           Float
  lng           Float
  website       String?
  phone         String?
  serviceTimes  String[]
  attendance    String?
  coverImage    String?
  logoImage     String?
  // Short factual/editorial blurb, not a review — e.g. "A liturgical, contemplative congregation..."
  summary       String?

  // Set only for churches imported from an external directory (see
  // scripts/import-osm-churches.ts). Lets re-running an import upsert by
  // stable external identity instead of creating duplicates, and marks a
  // record as "factual directory data" rather than manually curated.
  osmId String? @unique

  // Denomination-level reference data (see the Denomination model below).
  // Null means either "not yet matched" (raw string didn't hit an alias —
  // surfaced in the admin triage queue) or "genuinely non-denominational."
  // `denomination` above stays the raw/display string regardless, so nothing
  // that already renders it breaks.
  denominationId  String?
  denominationRef Denomination? @relation(fields: [denominationId], references: [id])

  verification    ChurchVerification?
  suggestions     DenominationSuggestion[]
  editSuggestions ChurchEditSuggestion[]

  // Multi-source data pipeline — see the "Data provenance" section below.
  // A church can have several ChurchSource rows (one per source that's ever
  // reported data about it, e.g. one from OSM and one manually entered from
  // a denomination directory) once merged, plus one ChurchFieldSource per
  // scalar field recording which of those currently supplies it.
  sources      ChurchSource[]
  fieldSources ChurchFieldSource[]
  associations ChurchAssociation[]

  // Deleting a church is irreversible (see app/api/admin/churches/[id]/delete),
  // so it's reserved for ADMIN. A MODERATOR can only request it — see
  // ChurchDeletionRequest below.
  deletionRequests ChurchDeletionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags        ChurchTag[]
  experiences Experience[]
  savedBy     SavedChurch[]

  @@index([lat, lng])
  @@index([city])
  @@index([denominationId])
}

enum TagCategory {
  THEOLOGY
  ACCESSIBILITY
  WORSHIP
  COMMUNITY
  MENTAL_HEALTH
}

// Factual/structural tags (e.g. "Wheelchair", "Liturgical", "Fully Affirming").
// Kept separate from Experience so they can be curated/verified independent of
// any one person's story.
model Tag {
  id       String      @id @default(cuid())
  label    String
  category TagCategory
  icon     String?

  churches ChurchTag[]

  @@unique([label, category])
}

model ChurchTag {
  churchId String
  tagId    String

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([churchId, tagId])
}

enum ChurchEditSubmitterRole {
  VISITOR
  CHURCH_REPRESENTATIVE
}

// A community-submitted correction to a church's *factual* information —
// address, website, service times, summary blurb, or which curated tags
// apply (accessibility, worship style, programs, etc.) — as distinct from
// an Experience, which is a personal first-hand story. Anyone can submit
// one (self-identifying as a visitor or someone affiliated with the
// church); nothing here touches the Church row until an admin approves it
// in the "Church Edit Queue" (/admin/church-edit-queue), at which point all
// proposed changes are applied together. Reuses SuggestionStatus (see the
// Denominational Context section below) since the review lifecycle is
// identical to a DenominationSuggestion.
model ChurchEditSuggestion {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User                    @relation("SubmittedChurchEdits", fields: [submittedById], references: [id], onDelete: Cascade)
  submitterRole ChurchEditSubmitterRole

  // Every field below is a *proposed* value — null/empty means "no change
  // suggested for this," not "clear the existing value."
  website      String?
  address      String?
  city         String?
  serviceTimes String[]
  summary      String?

  // Tag ids (not a relation — these are proposals, not yet real ChurchTag
  // rows) to attach to the church on approval, one array per Tag category.
  addAccessibilityTagIds String[]
  addWorshipTagIds       String[]
  addCommunityTagIds     String[]
  addMentalHealthTagIds  String[]
  addTheologyTagIds      String[]

  // Free-text context/rationale, and the escape valve for anything that
  // doesn't fit a structured field above (e.g. a program not yet in our tag
  // vocabulary).
  note String? @db.Text

  status       SuggestionStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?            @relation("ReviewedChurchEdits", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([churchId])
  @@index([status])
}

// A MODERATOR can request a church be deleted (e.g. it was imported by
// mistake and isn't a real church) but can't perform the deletion itself —
// that's still ADMIN-only and irreversible (see
// app/api/admin/churches/[id]/delete). Approving a request actually deletes
// the church (which cascades away this row too, via onDelete: Cascade on
// churchId); dismissing just declines the request and keeps the church.
model ChurchDeletionRequest {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  reason String @db.Text

  requestedById String?
  requestedBy   User?   @relation("RequestedChurchDeletions", fields: [requestedById], references: [id], onDelete: SetNull)

  status       DeletionRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                 @relation("ReviewedChurchDeletions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([churchId])
  @@index([status])
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  DISMISSED
}

// ---------- Data provenance / multi-source pipeline ----------
//
// Church itself stays the single canonical record every other part of the
// app reads (church pages, search, saves, experiences all still just point
// at Church, unchanged). What's new is *how* that canonical record gets
// populated and kept up to date, from more than just OpenStreetMap:
//
//   1. Each raw import/entry from a source becomes its own ChurchSource row
//      — OSM, a manually-entered directory listing (Shepherd's Stream, a
//      denomination directory), a church's own website, or an approved
//      ChurchEditSuggestion. The raw payload is preserved verbatim in
//      `rawData` even after merging, so nothing is ever lost to
//      normalization.
//   2. lib/church-matching.ts scores every pair of not-yet-merged
//      ChurchSource rows for "is this the same real-world church" —
//      scripts/generate-merge-candidates.ts creates a ChurchMergeCandidate
//      for every pair worth looking at.
//   3. scripts/apply-merges.ts auto-merges candidates that score above the
//      high-confidence threshold; everything in between sits PENDING in the
//      admin Merge Review queue for a human decision, and low scores are
//      simply never turned into a candidate at all (see
//      lib/church-matching.ts for thresholds).
//   4. On merge, a ChurchFieldSource row per Church field records *which*
//      source currently supplies it and at what confidence — a field is
//      only ever overwritten by a source with strictly higher confidence
//      (or one that fills in something previously unknown), never blindly
//      replaced. This is what lets the UI show "Source: OpenStreetMap" /
//      "Verified from church website" / etc. next to any given fact.

enum ChurchSourceType {
  OSM
  SHEPHERDS_STREAM
  DENOMINATION_DIRECTORY
  CHURCH_WEBSITE
  USER_SUBMITTED
  ADMIN
  // A general third-party directory (churchfinder.com), imported via
  // scripts/import-church-finder.ts — distinct from SHEPHERDS_STREAM (a
  // different directory with no API, manual-entry only) and from
  // DENOMINATION_DIRECTORY (official, denomination-run listings).
  CHURCH_FINDER
}

// How much a given source's data should be trusted, independent of which
// specific source type it is (e.g. an ADMIN entry that's just a quick guess
// should still be markable UNVERIFIED). Ordering below is the trust order
// used when deciding whether a new value is allowed to overwrite an
// existing field — see lib/church-matching.ts's CONFIDENCE_RANK.
enum SourceConfidence {
  UNVERIFIED
  LOW
  MEDIUM
  HIGH
}

// The Church (and, for the four *_TAGS entries, ChurchTag-category)
// attributes we track per-source provenance for. Deliberately a fixed list
// rather than a free-text field name, so ChurchFieldSource stays type-safe
// and every value here has a corresponding real column/relation on Church.
enum ChurchFieldName {
  NAME
  ADDRESS
  CITY
  STATE
  ZIP
  LAT
  LNG
  WEBSITE
  PHONE
  SERVICE_TIMES
  ATTENDANCE
  SUMMARY
  COVER_IMAGE
  LOGO_IMAGE
  DENOMINATION
  ACCESSIBILITY_TAGS
  WORSHIP_TAGS
  COMMUNITY_TAGS
  MENTAL_HEALTH_TAGS
  THEOLOGY_TAGS
}

enum MergeStatus {
  PENDING
  AUTO_MERGED
  APPROVED
  REJECTED
  // Admin looked at it and decided it's a legitimate near-miss, not a
  // duplicate (e.g. two different churches that happen to share a
  // building) — distinct from REJECTED so it's not just "the same as
  // rejected," it's "deliberately confirmed as two different churches."
  IGNORED
}

// One raw record from one source about (what may or may not turn out to
// be) one church. Never mutated to "match" other sources — normalization
// happens only in the flat fields below, `rawData` stays exactly as
// received. `churchId` starts null and is only set once this source has
// been merged into a canonical Church (see MergeStatus above).
model ChurchSource {
  id String @id @default(cuid())

  sourceType ChurchSourceType
  // The source's own identifier for this record — an OSM "node/12345", a
  // directory's internal id if it has one, or just the source URL for a
  // manually-entered directory/website lookup. Uniqueness is scoped to
  // sourceType, not global, since different sources have unrelated ID
  // schemes.
  externalId String

  rawData Json

  // Normalized snapshot at import/entry time — flat and indexable (unlike
  // rawData) so the matching engine and admin UI can query/compare
  // directly without re-parsing JSON every time.
  name            String
  address         String?
  city            String?
  state           String?
  zip             String?
  lat             Float?
  lng             Float?
  website         String?
  phone           String?
  serviceTimes    String[]
  denomination    String?
  // Free text as the source describes it (e.g. "Contemporary", "Traditional
  // with communion weekly") — mapped onto our curated WORSHIP tag
  // vocabulary at merge time, not stored as a Tag id here since a raw
  // source has no knowledge of our internal taxonomy.
  worshipStyleRaw String?
  // Free text ministry/program names as the source lists them (e.g. "Kids
  // Ministry", "Youth Group", "College Ministry") — same idea, mapped onto
  // curated COMMUNITY tags at merge time via best-effort label matching;
  // anything that doesn't match an existing tag is surfaced for an admin
  // to add to the taxonomy rather than silently dropped.
  ministryTagsRaw String[]

  confidence SourceConfidence @default(UNVERIFIED)

  churchId String?
  church   Church? @relation(fields: [churchId], references: [id], onDelete: SetNull)

  // Set when an admin looks at an unmatched orphan in the merge queue and
  // decides it isn't worth turning into a church (an org/diocese page, a
  // listing too sparse to use, a duplicate that will never geocode, etc.)
  // — the record itself is never deleted (raw data is never blindly
  // discarded), just hidden from the "unmatched listings" queue going
  // forward.
  dismissedAt   DateTime?
  dismissedById String?
  dismissedBy   User?     @relation("DismissedChurchSources", fields: [dismissedById], references: [id], onDelete: SetNull)

  // Who entered this, for USER_SUBMITTED/ADMIN types (manual directory
  // lookups, church-submitted info). Null for OSM.
  submittedById String?
  submittedBy   User?   @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldSources     ChurchFieldSource[]
  mergeCandidatesA ChurchMergeCandidate[] @relation("CandidateSourceA")
  mergeCandidatesB ChurchMergeCandidate[] @relation("CandidateSourceB")

  @@unique([sourceType, externalId])
  @@index([churchId])
  @@index([lat, lng])
}

// Which source currently supplies a given Church field, and how much it
// should be trusted — one row per (church, field). This is the thing the
// public UI reads to show "Source: OpenStreetMap" / "Verified from church
// website" next to a fact, and what the merge logic consults before
// deciding whether a new value is allowed to overwrite the current one.
model ChurchFieldSource {
  id String @id @default(cuid())

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  field ChurchFieldName

  sourceType ChurchSourceType
  sourceId   String?
  source     ChurchSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  confidence SourceConfidence

  // Who/what last set this field this way — an admin choosing which source
  // wins during a manual merge review, or the merge pipeline running
  // unattended (null in that case).
  setById String?
  setBy   User?    @relation(fields: [setById], references: [id], onDelete: SetNull)
  setAt   DateTime @default(now())

  @@unique([churchId, field])
  @@index([churchId])
}

// A candidate pairing of two not-yet-reconciled ChurchSource rows that
// might describe the same real-world church, produced by
// scripts/generate-merge-candidates.ts. Always ordered so sourceAId <
// sourceBId (enforced by the generator, not the database) so the same pair
// can't produce two candidates in opposite order.
model ChurchMergeCandidate {
  id String @id @default(cuid())

  sourceAId String
  sourceA   ChurchSource @relation("CandidateSourceA", fields: [sourceAId], references: [id], onDelete: Cascade)
  sourceBId String
  sourceB   ChurchSource @relation("CandidateSourceB", fields: [sourceBId], references: [id], onDelete: Cascade)

  score          Int
  // { name: number, address: number, cityStateZip: number, geo: number, website: number } —
  // see lib/church-matching.ts. Stored so an admin reviewing the queue (or a
  // future re-tuning of the algorithm) can see *why* a score landed where
  // it did, not just the final number.
  scoreBreakdown Json

  status       MergeStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([sourceAId, sourceBId])
  @@index([status])
  @@index([score])
}

// A looser network/fellowship a church can belong to alongside (or instead
// of) a formal Denomination — e.g. a regional church-planting network or a
// cooperative like the Willow Creek Association. Many-to-many with Church,
// unlike Denomination which is one-per-church, since a congregation can
// belong to several associations at once without that implying a formal
// denominational tie.
model Association {
  id          String   @id @default(cuid())
  name        String   @unique
  website     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  churches ChurchAssociation[]
}

model ChurchAssociation {
  churchId      String
  associationId String

  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@id([churchId, associationId])
}

// ---------- Denominational Context ----------
//
// Background reference data about a religious body/tradition — sourced from
// public denominational statements, never from any one congregation. It
// exists to give visitors context before they've collected any first-hand
// reports, and it must never be presented as a claim about what a specific
// local church believes or does: local practice can and does vary from
// official denominational policy. See lib/denomination-context.ts for how
// this is combined with a church's own ChurchVerification (if any) and
// aggregated visitor Experience data into the confidence-labeled "Denominational
// Context" section rendered by components/church/denominational-context.tsx.

enum PolicyStatus {
  YES
  NO
  VARIES
  UNKNOWN
  // The office/practice doesn't exist in this body's polity at all (e.g. no
  // "bishop" role in a strictly congregational denomination that also
  // doesn't ordain women), so "Yes/No" would misleadingly imply the question
  // was actively considered and declined.
  NOT_APPLICABLE
}

enum Tradition {
  CATHOLIC
  EASTERN_ORTHODOX
  ORIENTAL_ORTHODOX
  BAPTIST
  METHODIST
  LUTHERAN
  PRESBYTERIAN
  ANGLICAN
  PENTECOSTAL
  RESTORATION_MOVEMENT
  LATTER_DAY_SAINT
  SEVENTH_DAY_ADVENTIST
  NON_DENOMINATIONAL
  // A church formally affiliated with more than one denomination at once
  // (e.g. a federated/union church, or a congregation in full communion
  // with two traditions) — genuinely distinct from NON_DENOMINATIONAL, which
  // means no denominational affiliation at all rather than several at once.
  ECUMENICAL
  MAINLINE_PROTESTANT
  EVANGELICAL
  WESLEYAN_HOLINESS
  ANABAPTIST
  OTHER
  UNKNOWN
  // Deprecated: superseded by EASTERN_ORTHODOX/ORIENTAL_ORTHODOX and
  // LUTHERAN respectively. Kept (rather than removed, which Postgres can't
  // do for an enum without a disruptive type-swap) only so any historical
  // row that still references one of these the moment before a data
  // migration runs doesn't hard-fail. Nothing should newly select these —
  // see lib/denomination-labels.ts, which excludes them from the options list.
  ORTHODOX
  CONFESSIONAL
}

enum Governance {
  EPISCOPAL
  PRESBYTERIAN
  CONGREGATIONAL
  CONNECTIONAL
  HIERARCHICAL
  REPRESENTATIVE
  SYNODICAL
  COOPERATIVE
  OTHER
  UNKNOWN
}

// Shown next to every belief field so a reader can see at a glance whether
// it reflects the denomination's official stance, this specific church's own
// published statement, what visitors have reported, or nothing at all.
enum BeliefConfidence {
  DENOMINATION_ONLY
  VERIFIED_CHURCH_WEBSITE
  VISITOR_REPORTED
  UNKNOWN
}

model Denomination {
  id   String @id @default(cuid())
  name String @unique

  tradition  Tradition  @default(UNKNOWN)
  governance Governance @default(UNKNOWN)

  // A sentence or two of descriptive context (e.g. "Traditionally traces its
  // origins to the early Christian Church in the 1st century AD..."), shown
  // under an "Origins" heading instead of a bare year — `founded` alone
  // conflates "when this tradition began" with "when this specific
  // organization was formally constituted," which for most bodies are very
  // different dates. Falls back to a generated "Founded in {founded}"
  // sentence when left blank.
  originsNote      String?
  founded          Int?
  headquarters     String?
  membershipApprox String?
  website          String?
  beliefsUrl       String?

  allowsLgbtqClergy               PolicyStatus @default(UNKNOWN)
  allowsSameSexMarriage           PolicyStatus @default(UNKNOWN)
  requiresChurchesSameSexMarriage PolicyStatus @default(UNKNOWN)
  allowsWomenPastors              PolicyStatus @default(UNKNOWN)
  allowsWomenBishops              PolicyStatus @default(UNKNOWN)

  communionPractice String?
  baptismPractice   String?
  // Free-text nuance that the fixed fields above can't capture (e.g. "pastor
  // discretion" carve-outs) — always paired with a source, never asserted on
  // its own.
  notes             String? @db.Text

  lastUpdated DateTime @default(now())

  sources     DenominationSource[]
  aliases     DenominationAlias[]
  churches    Church[]
  suggestions DenominationSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A denomination-level fact is often backed by more than one citation (e.g.
// a news report of a policy change plus the denomination's own position
// paper). Kept separate from Denomination so adding a source never means
// overwriting or losing an earlier one.
model DenominationSource {
  id             String   @id @default(cuid())
  denominationId String
  url            String
  label          String?
  retrievedAt    DateTime @default(now())

  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Cascade)

  @@index([denominationId])
}

// Data-driven OSM/free-text -> Denomination matching (see
// lib/denomination-matching.ts), instead of a hardcoded JS lookup table, so
// admins can extend coverage without a deploy.
model DenominationAlias {
  id    String @id @default(cuid())
  // Normalized (lowercased/trimmed) raw string, e.g. "umc", "southern baptist".
  alias String @unique

  denominationId String
  denomination   Denomination @relation(fields: [denominationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// An admin's confirmation that a specific church's own website/statement
// says something different (or more specific) than the denomination default
// — e.g. an LCMS congregation that has publicly broken from the synod's
// stance. Optional and per-church; any field left null falls back to
// denomination-level data or visitor reports (see lib/denomination-context.ts).
model ChurchVerification {
  id       String @id @default(cuid())
  churchId String @unique
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  lgbtqClergy                     PolicyStatus?
  sameSexMarriage                 PolicyStatus?
  requiresChurchesSameSexMarriage PolicyStatus?
  womenPastors                    PolicyStatus?
  womenBishops                    PolicyStatus?

  sourceUrl String
  note      String?

  verifiedById String?
  verifiedBy   User?    @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime @default(now())
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A candidate denomination match for a church that isn't linked yet,
// produced by an automated scan (see scripts/scan-church-websites.ts and
// lib/website-denomination-scan.ts) rather than the deterministic alias
// table — so it always needs a human decision before it touches Church.
// denominationId. Reviewed in the admin "Verification Queue"
// (/admin/verification-queue).
model DenominationSuggestion {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // Null means the scan ran and found no denominational signal at all —
  // still worth recording (confirms the check happened) rather than
  // silently doing nothing, but there's nothing for "Accept" to link.
  suggestedDenominationId String?
  suggestedDenomination   Denomination? @relation(fields: [suggestedDenominationId], references: [id], onDelete: Cascade)

  // 0-100, null when suggestedDenominationId is also null (no signal).
  confidence Int?
  // The exact text snippet that triggered the match, so a reviewer can see
  // *why* without re-visiting the site themselves.
  evidence   String? @db.Text
  sourceUrl  String?

  status       SuggestionStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([churchId])
  @@index([status])
}

// ---------- Experiences (the "reviews", reframed) ----------

enum MemberStatus {
  VISITOR
  REGULAR_ATTENDER
  CURRENT_MEMBER
  FORMER_MEMBER
}

// Experiences publish immediately (APPROVED). PENDING is only reached
// automatically, when a submission trips the spam/abuse filter — see
// lib/moderation.ts — and means "auto-held, needs a human look."
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LgbtqExperience {
  AFFIRMING
  MIXED
  NOT_AFFIRMING
  NOT_REPORTED
}

enum TriState {
  YES
  SOME
  NO
  UNKNOWN
}

model Experience {
  id       String @id @default(cuid())
  churchId String
  userId   String

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public display fields. displayName is a pseudonym the user picks per-story,
  // never their account name/email, so a story can't be traced to an account.
  displayName  String
  visitLabel   String
  memberStatus MemberStatus
  text         String       @db.Text

  // Structured, self-reported facts. All optional — someone can share a story
  // without answering every question. These are the only inputs to the
  // computed Community Snapshot; nothing here is itself a 1-5 "rating".
  feltSafe            Boolean?
  feltRespected       Boolean?
  wouldReturn         Boolean?
  lgbtqExperience     LgbtqExperience?
  womenInLeadership   TriState?
  accessibilityRating Int? // 1-5, presence/quality of accommodations they personally used
  mentalHealthRating  Int? // 1-5, how openly/well mental health was supported

  moderationStatus ModerationStatus @default(APPROVED)
  moderationNote   String?

  identities   ExperienceIdentity[]
  helpfulVotes HelpfulVote[]
  reports      Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, moderationStatus, createdAt])
  @@index([userId])
}

// A member flagging a specific experience for review — spam, harassment,
// doesn't seem genuine, etc. Reports never auto-hide content themselves
// (that would let coordinated reporting silence real stories); they only
// surface it in the admin dashboard for a human decision.
model Report {
  id           String @id @default(cuid())
  experienceId String
  userId       String
  reason       String

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([experienceId, userId])
}

model ExperienceIdentity {
  experienceId String
  identityId   String

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  identity   Identity   @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([experienceId, identityId])
}

model HelpfulVote {
  userId       String
  experienceId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, experienceId])
}

model SavedChurch {
  userId   String
  churchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, churchId])
}
