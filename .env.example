# Copy to .env and fill in for local development.

# Local Postgres started via `docker compose up -d`.
DATABASE_URL="postgresql://opendoors:opendoors@localhost:5432/opendoors?schema=public"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email (magic link) provider. For local dev, run `docker compose up -d` and use
# the bundled Mailpit SMTP server + inbox at http://localhost:8025 — nothing sends
# to real inboxes. In production, swap in your real SMTP provider (Postmark, Resend, SES, ...).
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Open Doors <hello@opendoors.example>"
