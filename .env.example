# Copy to .env and fill in for local development.

# Local Postgres started via `docker compose up -d`.
DATABASE_URL="postgresql://opendoors:opendoors@localhost:5432/opendoors?schema=public"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email (magic link) provider — sent via Resend's HTTPS API. Get/rotate a
# key at https://resend.com/api-keys. EMAIL_FROM must be an address at a
# domain verified in Resend (https://resend.com/domains), or use Resend's
# test address "onboarding@resend.dev" (only delivers to the address you
# signed up to Resend with).
RESEND_API_KEY=""
EMAIL_FROM="Open Doors <hello@opendoors.example>"

# Apify — only needed to run scripts/import-church-finder.ts. Get a token at
# https://console.apify.com/settings/integrations. Leave blank if you're not
# running that import.
APIFY_API_TOKEN=""

# Temporary pre-launch access gate (see middleware.ts) — comma-separated
# emails allowed to sign in and use the site at all. Leave blank locally to
# test as if you're not on the allowlist; add your own email to test as if
# you are. Remove middleware.ts and this variable once the site is public.
ALLOWED_EMAILS=""
